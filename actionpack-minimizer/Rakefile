require "bundler/gem_tasks"
require "rake/testtask"

# One repository, five gems: release tags are actionpack-minimizer-v<version>.
Bundler::GemHelper.tag_prefix = "actionpack-minimizer-"

Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

task default: :test
