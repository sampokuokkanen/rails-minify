require "bundler"
require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

task default: :test

desc "Run the tests against Rails 8.0 (Gemfile.rails80) and Rails main (Gemfile.edge, pinned ref)"
task "test:rails" do
  %w[Gemfile.rails80 Gemfile.edge].each do |gemfile|
    # A clean env, or the outer `bundle exec` leaks its Gemfile into the inner one.
    Bundler.with_unbundled_env { sh({ "BUNDLE_GEMFILE" => gemfile }, "bundle exec rake test") }
  end
end
